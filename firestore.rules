rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'akshatpopat9311@gmail.com' && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 150
        && (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 100))
        && (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 20))
        && (!data.keys().hasAny(['address']) || (data.address is string && data.address.size() <= 255))
        && (!data.keys().hasAny(['birthday']) || (data.birthday is string && data.birthday.size() <= 30))
        && (!data.keys().hasAny(['role']) || (data.role in ['user', 'admin']));
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().uid == userId;
      allow update: if (isAdmin() || isOwner(userId)) && isValidUser(incoming()) && incoming().uid == existing().uid && incoming().email == existing().email;
      allow list: if isAdmin();
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['email'])
        && data.email is string && data.email.size() <= 150
        && (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 100))
        && (!data.keys().hasAny(['subscribedAt']) || (data.subscribedAt is string && data.subscribedAt.size() <= 30));
    }

    match /subscribers/{subscriberId} {
      allow read, list: if isAdmin();
      allow create: if isValidId(subscriberId) && isValidSubscriber(incoming());
      allow update, delete: if isAdmin();
    }
  }
}
